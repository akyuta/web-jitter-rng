{
    "name": "web-jitter-rng-monorepo",
    "private": true,
    "workspaces": [
        "packages/*",
        "apps/*"
    ],
    "scripts": {
        "dev": "npm run dev -w web-jitter-rng-demo",
        "build": "npm run build -w web-jitter-rng-demo",
        "test": "node scripts/patch-rollup-fallback.js && npm run build -w randomness && npm run test -w web-jitter-rng",
        "quality-test": "tsx scripts/randomnessQualityTest.ts",
        "quality-test:raw": "tsx scripts/randomnessQualityTest.ts --raw"
    },
    "dependencies": {
        "fft.js": "^4.0.4",
        "mathjs": "^12.4.2"
    },
    "devDependencies": {
        "@types/node": "^24.10.1",
        "tsx": "^4.21.0"
    }
}
